# Conexión pooled (PgBouncer/Neon pooler) — la usan la app en runtime y las funciones
# serverless de Vercel. En Supabase: Settings > Database > Connection string > "Transaction"
# pooler (puerto 6543). En Neon: el endpoint por defecto ya es el pooled.
DATABASE_URL="postgresql://user:password@host:5432/nexo_inmobiliario?schema=public"

# Conexión directa, sin pooler — la necesitan `prisma migrate deploy` y `prisma db seed`.
# En Supabase: Settings > Database > Connection string > "Session" (puerto 5432). En Neon: el
# endpoint marcado "unpooled"/"direct".
DIRECT_URL="postgresql://user:password@host:5432/nexo_inmobiliario?schema=public"
